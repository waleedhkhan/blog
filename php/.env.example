# Copy to .env and fill in. Keep .env OUT of the web root in production
# (this file lives above public/, so it is never served).

# Spotify "now playing" — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Umami analytics (optional; a default id is baked in if unset)
UMAMI_WEBSITE_ID=
